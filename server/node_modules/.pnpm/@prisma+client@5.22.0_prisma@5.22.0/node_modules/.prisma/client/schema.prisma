generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  phone              String
  address            String
  city               String
  customerType       String    @default("RESIDENTIAL")
  contractedPowerKva Float     @default(4.0)
  role               String    @default("CLIENT")
  sessions           Session[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Zone {
  id                 String      @id @default(cuid())
  zoneNumber         Int         @unique // 1, 2, 3, 4
  name               String // Critical Zone, High Priority Zone, Medium Priority Zone, Low Priority Zone
  priority           String // Critical, High, Medium, Low
  priorityLevel      Int // 1, 2, 3, 4
  defaultConsumption Float // kW: 5, 4, 6, 3
  currentConsumption Float       @default(0) // kW
  dailyConsumption   Float       @default(0) // kWh
  monthlyConsumption Float       @default(0) // kWh
  maxLimit           Float // kW limit
  isConnected        Boolean     @default(true)
  reductionPercent   Float       @default(0) // 0 to 100%
  color              String
  appliances         Appliance[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Appliance {
  id                   String   @id @default(cuid())
  name                 String
  category             String // Cooling, Computing, Essential, Appliances, Lighting, Outdoor
  zoneId               String
  zone                 Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  nominalPower         Float // in Watts (e.g. 1500)
  dailyHours           Float // daily operating hours (e.g. 8)
  operatingFreq        Float    @default(1) // times per day or duty cycle
  installationDate     DateTime @default(now())
  ageYears             Float    @default(1.0)
  efficiency           Float    @default(95.0) // percentage
  status               String   @default("ON") // ON, OFF, REDUCED
  energyClass          String   @default("A++") // A+++, A++, A+, A, B, C, D
  degradationRate      Float    @default(1.5) // % efficiency drop per year
  maintenanceCondition String   @default("Good") // Excellent, Good, Fair, Poor
  baselineKwh          Float    @default(0) // original baseline daily kWh
  estimatedDailyKwh    Float    @default(0)
  estimatedMonthlyKwh  Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Battery {
  id              String   @id @default(cuid())
  batteryNumber   Int      @unique // 1, 2, 3
  name            String // Battery 1, Battery 2, Battery 3
  capacity        Float // kWh: 20, 15, 10
  soc             Float // State of charge %: 95, 70, 45
  soh             Float    @default(98.0) // State of Health %
  minSoc          Float    @default(20.0) // Minimum SOC %
  maxSoc          Float    @default(98.0) // Maximum SOC %
  maxChargeKw     Float    @default(5.0) // Max charge rate kW
  maxDischargeKw  Float    @default(5.0) // Max discharge rate kW
  chargingStatus  String   @default("IDLE") // IDLE, CHARGING, DISCHARGING
  priority        Int      @default(1) // charge/discharge priority order
  storedEnergy    Float    @default(0) // kWh = capacity * soc / 100
  availableEnergy Float    @default(0) // kWh = capacity * (soc - minSoc) / 100
  roundtripEff    Float    @default(92.0) // % efficiency
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EnergyReading {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  solarProduction  Float // kW
  totalConsumption Float // kW
  batteryPower     Float // kW (+ charging, - discharging)
  gridImport       Float    @default(0) // kW
  gridExport       Float    @default(0) // kW
  netBalance       Float // kW: Solar - Consumption
  state            String // SURPLUS, BALANCED, DEFICIT
  intervalType     String   @default("HOURLY") // HOURLY, DAILY, MONTHLY
}

model SolarProduction {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  powerKw          Float
  irradiation      Float // W/m²
  temperature      Float // °C
  weatherCondition String   @default("Sunny") // Sunny, Partly Cloudy, Cloudy, Rainy
}

model EnergyTransaction {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  energyKwh      Float
  pricePerKwh    Float // in TND (e.g. 0.250)
  totalAmountTnd Float // in TND
  type           String   @default("EXPORT") // EXPORT, IMPORT
  status         String   @default("COMPLETED") // COMPLETED, SIMULATED
}

model SimulationScenario {
  id              String   @id @default(cuid())
  name            String
  description     String
  solarFactor     Float    @default(1.0)
  zone1Multiplier Float    @default(1.0)
  zone2Multiplier Float    @default(1.0)
  zone3Multiplier Float    @default(1.0)
  zone4Multiplier Float    @default(1.0)
  battery1Soc     Float    @default(95.0)
  battery2Soc     Float    @default(70.0)
  battery3Soc     Float    @default(45.0)
  isPreset        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model SimulationResult {
  id                    String   @id @default(cuid())
  scenarioName          String
  timestamp             DateTime @default(now())
  initialDeficitSurplus Float
  finalDeficitSurplus   Float
  zonesShed             String // JSON string of shed zones
  batteriesUsed         String // JSON string of battery states
  energyExported        Float    @default(0)
  financialImpactTnd    Float    @default(0)
  decisionLogs          String // JSON array of decisions
}

model DistributionDecision {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  reason         String
  situation      String // SURPLUS, DEFICIT, BALANCED, CRITICAL
  action         String
  affectedEntity String // Zone 4, Battery 1, Grid, All
  mode           String   @default("AUTOMATIC") // AUTOMATIC, MANUAL, ECO
}

model Notification {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  severity    String // CRITICAL, WARNING, INFORMATION
  title       String
  description String
  entityType  String? // Zone, Battery, Solar, Billing
  entityId    String?
  isRead      Boolean  @default(false)
}

model TariffVersion {
  id               String          @id @default(cuid())
  name             String // "STEG Official BT 2024-2025"
  version          String // "v2.1"
  effectiveFrom    DateTime        @default(now())
  effectiveTo      DateTime?
  customerCategory String          @default("RESIDENTIAL") // RESIDENTIAL, NON_RESIDENTIAL
  powerFeePerKva   Float           @default(0.700) // TND / kVA / month
  isActive         Boolean         @default(true)
  brackets         TariffBracket[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model TariffBracket {
  id              String        @id @default(cuid())
  tariffVersionId String
  tariffVersion   TariffVersion @relation(fields: [tariffVersionId], references: [id], onDelete: Cascade)
  minKwh          Float // e.g. 0
  maxKwh          Float // e.g. 50 (or 99999 for over 500)
  pricePerKwhTnd  Float // in TND (e.g. 0.062, 0.096, 0.176, 0.218, 0.341, 0.414)
  vatRate         Float         @default(0.07) // 7% or 13%
}

model ElectricityBill {
  id                     String   @id @default(cuid())
  customerType           String   @default("RESIDENTIAL")
  contractedPowerKva     Float    @default(4.0)
  billingPeriodMonths    Int      @default(2) // 1 month, 2 months (bimonthly STEG)
  startPeriod            DateTime
  endPeriod              DateTime
  totalKwh               Float
  solarDeductionKwh      Float    @default(0)
  netKwh                 Float
  energyCostTnd          Float // Total HT
  fixedPowerFeeTnd       Float // Redevance fixe
  vatTnd                 Float // Total TVA
  municipalTaxTnd        Float    @default(0) // Collectivités locales
  energyTransitionTaxTnd Float    @default(1.250) // FTE
  rttTaxTnd              Float    @default(0.500) // RTT
  totalTtcTnd            Float // Total TTC
  isSimulated            Boolean  @default(true)
  createdAt              DateTime @default(now())
}

model MonthlyReport {
  id                  String   @id @default(cuid())
  month               Int
  year                Int
  totalSolarKwh       Float
  totalConsumptionKwh Float
  selfConsumedKwh     Float
  exportedKwh         Float
  importedKwh         Float
  estimatedBillTnd    Float
  savingsTnd          Float
  co2AvoidedKg        Float
  peakDemandKw        Float
  createdAt           DateTime @default(now())
}

model SystemSettings {
  id                   String   @id @default("default")
  platformName         String   @default("SMARTGRID Energy Platform")
  currency             String   @default("TND")
  language             String   @default("English")
  timezone             String   @default("Africa/Tunis")
  operatingMode        String   @default("AUTOMATIC") // AUTOMATIC, MANUAL, ECO
  autoSellEnabled      Boolean  @default(true)
  sellPriceTnd         Float    @default(0.250) // TND / kWh
  minBatteryReservePct Float    @default(30.0) // Minimum reserve % before selling
  exportThresholdKw    Float    @default(1.0) // Minimum surplus kW to trigger export
  co2FactorKgPerKwh    Float    @default(0.580) // 0.58 kg CO2 per kWh grid in Tunisia
  simulationSpeed      Float    @default(1.0)
  defaultSolarCapacity Float    @default(15.0) // kW peak
  updatedAt            DateTime @updatedAt
}
